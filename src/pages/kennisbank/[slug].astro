---
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceRow from '../../components/ServiceRow.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';
import { owner } from '../../data/owner';
import { getService } from '../../data/services';
import { localBusinessJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
	const articles = await getCollection('kennisbank');
	return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const service = getService(article.data.service);
const toc = headings.filter((h) => h.depth === 2);
const words = (article.body ?? '').split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 200));
const all = (await getCollection('kennisbank')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((a) => a.id !== article.id).slice(0, 3);

const url = `${site.siteUrl}/kennisbank/${article.id}/`;
const jsonLd = [
	localBusinessJsonLd(),
	breadcrumbJsonLd([
		{ name: 'Home', url: `${site.siteUrl}/` },
		{ name: 'Kennisbank', url: `${site.siteUrl}/kennisbank/` },
		{ name: article.data.title, url },
	]),
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: article.data.title,
		description: article.data.description,
		inLanguage: 'nl-BE',
		mainEntityOfPage: url,
		dateModified: `${article.data.updated}-01`,
		author: { '@type': 'Person', name: owner.name, jobTitle: owner.role, worksFor: { '@id': `${site.siteUrl}/#business` } },
		publisher: { '@id': `${site.siteUrl}/#business` },
		image: `${site.siteUrl}/brand/og-${service?.slug ?? 'default'}.jpg`,
	},
];
---

<Base title={`${article.data.title} | Ciya Dakwerken`} description={article.data.description} path={`/kennisbank/${article.id}/`} {jsonLd} ogImage={`/brand/og-${service?.slug ?? 'default'}.jpg`}>
	<nav class="breadcrumb" aria-label="Kruimelpad">
		<div class="container">
			<a href="/">Home</a><span aria-hidden="true">/</span>
			<a href="/kennisbank/">Kennisbank</a><span aria-hidden="true">/</span>
			<span aria-current="page">{article.data.question}</span>
		</div>
	</nav>

	<article class="section article">
		<div class="container article__grid">
			<header class="article__head">
				<Eyebrow>Kennisbank · {service?.name ?? 'Dakwerken'}</Eyebrow>
				<h1>{article.data.title}</h1>
				<p class="article__lede">{article.data.description}</p>
				<p class="article__meta">
					<span><Icon name="clock" /> {minutes} min lezen</span>
					<span>Door {owner.name}, {owner.role.toLowerCase()}</span>
					<span>Bijgewerkt {article.data.updated}</span>
				</p>
			</header>

			<aside class="article__side">
				{
					toc.length > 1 && (
						<nav class="toc" aria-label="Inhoud">
							<p class="toc__title">In dit artikel</p>
							<ol>
								{toc.map((h) => (
									<li><a href={`#${h.slug}`}>{h.text}</a></li>
								))}
							</ol>
						</nav>
					)
				}
				<div class="side-panel article__cta">
					<p class="article__cta-title">Vraag over uw dak?</p>
					<p>Bel of mail, of doe de dakcheck — u krijgt een eerlijk antwoord.</p>
					<Button href={`tel:${site.phoneE164}`} variant="primary" icon="phone">Bel {site.phoneDisplay}</Button>
					<a class="article__cta-link" href="/dakcheck/">Doe de dakcheck →</a>
				</div>
			</aside>

			<div class="article__body prose">
				<Content />
			</div>
		</div>
	</article>

	{
		service && (
			<section class="section section--tight article__service">
				<div class="container">
					<p class="eyebrow">Gerelateerde dienst</p>
					<ServiceRow name={service.name} line={service.short} href={`/diensten/${service.slug}/`} icon={service.icon} />
				</div>
			</section>
		)
	}

	<section class="section section--tight article__more">
		<div class="container">
			<p class="eyebrow">Lees ook</p>
			<ul class="more">
				{others.map((a) => (
					<li><a href={`/kennisbank/${a.id}/`}><span class="more__q">{a.data.question}</span><strong>{a.data.title}</strong></a></li>
				))}
			</ul>
		</div>
	</section>

	<CtaBand />
</Base>

<style>
	.breadcrumb {
		padding-block: 1rem;
		border-bottom: var(--border-light);
		font-size: 0.85rem;
		color: var(--grey-500);
	}

	.breadcrumb .container {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.breadcrumb [aria-current='page'] {
		color: var(--ink);
		font-weight: 600;
	}

	.article__grid {
		display: grid;
		gap: 2.5rem;
	}

	@media (min-width: 1024px) {
		.article__grid {
			grid-template-columns: minmax(0, 68ch) 300px;
			column-gap: 4rem;
			grid-template-areas:
				'head side'
				'body side';
			align-items: start;
		}

		.article__head {
			grid-area: head;
		}

		.article__side {
			grid-area: side;
			position: sticky;
			top: 96px;
		}

		.article__body {
			grid-area: body;
		}
	}

	.article__head h1 {
		font-size: clamp(2.2rem, 1.7rem + 2vw, 3.6rem);
	}

	.article__lede {
		margin-top: 1.25rem;
		font-size: 1.15rem;
		color: var(--grey-700);
	}

	.article__meta {
		margin-top: 1.25rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		font-size: 0.875rem;
		color: var(--grey-500);
	}

	.article__meta span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.article__meta :global(.icon) {
		width: 16px;
		height: 16px;
		color: var(--red-600);
	}

	.toc {
		border-left: 3px solid var(--red-600);
		padding-left: 1rem;
		margin-bottom: 1.5rem;
	}

	.toc__title {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		margin-bottom: 0.5rem;
	}

	.toc ol {
		display: grid;
		gap: 0.35rem;
		counter-reset: toc;
	}

	.toc li a {
		font-size: 0.95rem;
		color: var(--grey-700);
	}

	.toc li a:hover {
		color: var(--red-700);
	}

	.article__cta {
		display: grid;
		gap: 0.75rem;
	}

	.article__cta-title {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 1.2rem;
	}

	.article__cta p:not(.article__cta-title) {
		color: var(--grey-500);
		font-size: 0.95rem;
	}

	.article__cta-link {
		font-weight: 700;
		color: var(--red-700);
	}

	/* Article typography */
	.prose :global(h2) {
		margin-top: 2.5rem;
		font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
	}

	.prose :global(h3) {
		margin-top: 1.75rem;
		font-family: var(--font-display);
		text-transform: uppercase;
		font-size: 1.35rem;
		letter-spacing: 0.01em;
	}

	.prose :global(p) {
		margin-top: 1.1rem;
		color: var(--grey-700);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin-top: 1.1rem;
		padding-left: 1.4rem;
		display: grid;
		gap: 0.5rem;
		color: var(--grey-700);
	}

	.prose :global(ul) {
		list-style: none;
		padding-left: 0;
	}

	.prose :global(ul li) {
		position: relative;
		padding-left: 1.5rem;
	}

	.prose :global(ul li::before) {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 10px;
		height: 10px;
		border-left: 3px solid var(--red-600);
		border-top: 3px solid var(--red-600);
		transform: rotate(45deg);
	}

	.prose :global(ol) {
		list-style: decimal;
	}

	.prose :global(ol li::marker) {
		font-family: var(--font-display);
		font-weight: 800;
		color: var(--red-600);
	}

	.prose :global(strong) {
		color: var(--ink);
	}

	.article__service,
	.article__more {
		border-top: var(--border-light);
	}

	.more {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 900px) {
		.more {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.more a {
		display: grid;
		gap: 0.35rem;
		padding: 1.25rem;
		border: var(--border-light);
		border-top: 3px solid transparent;
		border-radius: var(--radius);
		transition: border-top-color var(--dur-base) var(--ease);
	}

	.more a:hover {
		border-top-color: var(--red-600);
	}

	.more__q {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.78rem;
		color: var(--red-700);
	}

	.more strong {
		font-weight: 600;
		line-height: 1.35;
	}
</style>
