---
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import Frame from '../../components/Frame.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import OwnerCard from '../../components/OwnerCard.astro';
import { owner } from '../../data/owner';
import { site } from '../../data/site';
import { localBusinessJsonLd, breadcrumbJsonLd } from '../../lib/seo';

import bestelwagen from '../../assets/images/ciya-dakwerken-bestelwagen-werf.jpg';
import opHetDak from '../../assets/images/ciya-ismet-op-het-dak.jpg';

const title = 'Over Ciya Dakwerken | Dakwerker in Lokeren';
const description =
	'Ciya Dakwerken: meer dan 20 jaar ervaring in dakwerken, gespecialiseerd in platte daken. Persoonlijk advies en vakwerk in regio Lokeren (Oost-Vlaanderen).';

const processSteps = [
	'U neemt contact op via telefoon of het offerteformulier.',
	'Advies ter plaatse of telefonisch, op basis van uw situatie.',
	'U ontvangt een vrijblijvende offerte, zonder verrassingen achteraf.',
	'Na uw akkoord plannen we de werken in.',
	'Uitvoering en oplevering, met aandacht voor een nette afwerking.',
];

const jsonLd = [
	localBusinessJsonLd(),
	breadcrumbJsonLd([
		{ name: 'Home', url: `${site.siteUrl}/` },
		{ name: 'Over ons', url: `${site.siteUrl}/over-ons/` },
	]),
];
---

<Base {title} {description} path="/over-ons/" {jsonLd}>
	<!-- INTRO -->
	<section class="section">
		<div class="container intro">
			<div class="intro__text">
				<Eyebrow>Over ons</Eyebrow>
				<h1>Over Ciya Dakwerken</h1>
				<p class="intro__lede">
					{site.experience}, met platte daken als specialisatie. Ciya Dakwerken is een dakwerker
					uit Lokeren met een duidelijke aanpak: eerlijk advies, een heldere offerte en vakwerk,
					van het eerste contact tot de oplevering.
				</p>
				<p>
					Roofing, EPDM, lichtkoepels en dakisolatie vormen de kern van ons werk. Daarnaast plaatsen
					en herstellen we Velux dakramen, dakgoten en zinkwerk — ook op hellende daken. Bij
					nieuwbouw, renovatie en onderhoud, altijd met hoogwaardige materialen en garantie op de
					uitgevoerde werkzaamheden.
				</p>
				<div class="btn-row">
					<Button href="/offerte/" variant="primary">Offerte aanvragen</Button>
					<Button href="/projecten/" variant="ghost" icon="arrow" iconPosition="right">Bekijk realisaties</Button>
				</div>
			</div>
			<div class="intro__media">
				<Frame
					image={opHetDak}
					alt="Ciya Ismet op een hellende dakconstructie tijdens de werken"
					loading="eager"
					fetchpriority="high"
					widths={[480, 640, 800]}
					sizes="(min-width: 1024px) 440px, 90vw"
				/>
			</div>
		</div>
	</section>

	{
		owner.photo && (
			<section class="section section--tight owner-section">
				<div class="container">
					<OwnerCard eyebrow="Wie u aan de lijn krijgt" title="Ciya Ismet, zaakvoerder en dakwerker" />
				</div>
			</section>
		)
	}

	<!-- TRUST -->
	<section class="section section--tight trust">
		<div class="container">
			<TrustStrip />
		</div>
	</section>

	<!-- PILLARS -->
	<section class="section section--tight">
		<div class="container">
			<SectionHeading eyebrow="Waar we voor staan" title="Ervaring, werkwijze en regio" />
			<div class="pillars">
				<article class="pillar reveal" style="--stagger:0">
					<span class="pillar__num" aria-hidden="true">01</span>
					<h3>Ervaring</h3>
					<p>
						{site.experience}. Die ervaring zit vooral in platte daken: roofing en EPDM plaatsen en
						vernieuwen, lichtkoepels en dakramen inwerken, dakranden en goten afwerken. Een plat dak
						vergeeft weinig — een slordige aansluiting of een verkeerd gekozen materiaal komt vroeg
						of laat terug als lek. Net daarom kijken we eerst goed naar de ondergrond en de
						details, en pas daarna naar het materiaal.
					</p>
				</article>
				<article class="pillar reveal" style="--stagger:1">
					<span class="pillar__num" aria-hidden="true">02</span>
					<h3>Werkwijze</h3>
					<p>
						Persoonlijk en rechtuit. We komen langs, bekijken de situatie en zeggen eerlijk wat
						nodig is — en wat niet. Daarna krijgt u een duidelijke, vrijblijvende offerte waarin
						staat wat we doen en met welke materialen. Geen verrassingen achteraf. We kiezen niet
						het duurste, maar wat bij uw dak past, en we geven garantie op al onze
						werkzaamheden.
					</p>
				</article>
				<article class="pillar reveal" style="--stagger:2">
					<span class="pillar__num" aria-hidden="true">03</span>
					<h3>Regio</h3>
					<p>
						Ciya Dakwerken is gevestigd in Lokeren en werkt in {site.serviceArea}, in de regio
						Lokeren (Oost-Vlaanderen). Dichtbij, zodat we vlot ter plaatse kunnen zijn voor een
						plaatsbezoek, een herstelling of een controle na stormweer. Twijfelt u of uw adres
						binnen ons werkgebied valt? Bel gerust: {site.phoneDisplay}.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- PROCESS -->
	<section class="section section--dark">
		<div class="container">
			<SectionHeading eyebrow="Wat u kunt verwachten" title="Zo werken we" />
			<ProcessSteps steps={processSteps} tone="dark" />
		</div>
	</section>

	<!-- FACTS -->
	<section class="section section--tight">
		<div class="container facts">
			<div class="facts__media">
				<Frame image={bestelwagen} alt="Bestelwagen van Ciya Dakwerken op een werf bij een nieuwe garage" black widths={[480, 640, 760]} sizes="(min-width: 1024px) 380px, 90vw" />
			</div>
			<div class="facts__block">
				<SectionHeading level="h2" eyebrow="Gegevens" title="Bedrijfsgegevens" />
				<dl class="facts__list">
					<div>
						<dt>Onderneming</dt>
						<dd>{site.legalName}</dd>
					</div>
					<div>
						<dt>Handelsnaam</dt>
						<dd>{site.name}</dd>
					</div>
					<div>
						<dt>BTW</dt>
						<dd>{site.vatDisplay}</dd>
					</div>
					<div>
						<dt>Adres</dt>
						<dd>{site.address.street}, {site.address.postalCode} {site.address.city}</dd>
					</div>
					<div>
						<dt>Telefoon</dt>
						<dd><a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a></dd>
					</div>
					<div>
						<dt>E-mail</dt>
						<dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
					</div>
				</dl>
				<a class="facts__fb" href={site.facebook} rel="noopener" target="_blank">
					<Icon name="facebook" /> Volg ons op Facebook
				</a>
			</div>
		</div>
	</section>

	<CtaBand />
</Base>

<style>
	.intro {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 1024px) {
		.intro {
			grid-template-columns: 7fr 5fr;
			gap: 4rem;
		}
	}

	.intro__lede {
		margin-top: 1.5rem;
		font-size: 1.2rem;
		color: var(--ink);
		max-width: 40rem;
	}

	.intro__text > p + p {
		margin-top: 1rem;
		color: var(--grey-500);
		max-width: 40rem;
	}

	.intro .btn-row {
		margin-top: 2rem;
	}

	.intro__media {
		max-width: 440px;
		margin-inline: auto;
	}

	@media (min-width: 1024px) {
		.intro__media {
			margin-inline: 0;
			justify-self: end;
		}
	}

	.owner-section {
		border-top: var(--border-light);
	}

	.trust {
		border-top: var(--border-light);
		border-bottom: var(--border-light);
	}

	.pillars {
		display: grid;
		gap: 2rem;
	}

	@media (min-width: 900px) {
		.pillars {
			grid-template-columns: repeat(3, 1fr);
			gap: 2.5rem;
		}
	}

	.pillar {
		border-top: 3px solid var(--red-600);
		padding-top: 1rem;
	}

	.pillar__num {
		display: block;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 2.5rem;
		line-height: 1;
		color: var(--grey-300);
		margin-bottom: 0.5rem;
	}

	.pillar h3 {
		font-family: var(--font-display);
		text-transform: uppercase;
		font-weight: 700;
		font-size: 1.5rem;
		letter-spacing: 0.01em;
		margin-bottom: 0.75rem;
	}

	.pillar p {
		color: var(--grey-500);
	}

	.facts {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 1024px) {
		.facts {
			grid-template-columns: 380px 1fr;
			gap: 4rem;
		}
	}

	.facts__media {
		max-width: 380px;
	}

	.facts__list {
		display: grid;
		gap: 0;
		margin: 0;
		border-top: var(--border-light);
	}

	.facts__list > div {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 1rem;
		padding: 0.8rem 0;
		border-bottom: var(--border-light);
	}

	.facts__list dt {
		color: var(--grey-500);
		font-size: 0.9rem;
	}

	.facts__list dd {
		margin: 0;
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.facts__list a:hover {
		color: var(--red-700);
	}

	.facts__fb {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
		font-weight: 600;
	}

	.facts__fb :global(.icon) {
		color: var(--red-600);
	}

	.facts__fb:hover {
		color: var(--red-700);
	}
</style>
