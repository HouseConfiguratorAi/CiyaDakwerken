---
// Photo frame with an 8px solid offset block behind it (see BRIEF §2 `.frame--offset`).
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	alt: string;
	tag?: string;
	offset?: boolean;
	black?: boolean;
	widths?: number[];
	sizes?: string;
	loading?: 'eager' | 'lazy';
	fetchpriority?: 'high' | 'low' | 'auto';
	class?: string;
}

const {
	image,
	alt,
	tag,
	offset = true,
	black = false,
	widths = [320, 480, 640, 960],
	sizes = '(min-width: 1024px) 480px, 90vw',
	loading = 'lazy',
	fetchpriority = 'auto',
	class: className,
} = Astro.props;
---

<div class={`frame ${offset ? 'frame--offset' : ''} ${black ? 'frame--black' : ''} ${className ?? ''}`}>
	<Image
		src={image}
		alt={alt}
		widths={widths}
		sizes={sizes}
		loading={loading}
		fetchpriority={fetchpriority}
		formats={['avif', 'webp']}
	/>
	{tag && <span class="frame__tag">{tag}</span>}
</div>
