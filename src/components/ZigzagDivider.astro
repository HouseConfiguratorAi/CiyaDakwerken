---
interface Props {
	class?: string;
	flip?: boolean;
}
const { class: className, flip = false } = Astro.props;
---

<svg
	class={`zigzag ${className ?? ''}`}
	viewBox="0 0 40 6"
	preserveAspectRatio="none"
	aria-hidden="true"
	style={flip ? 'transform: scaleY(-1)' : undefined}
>
	<polyline points="0,6 5,0 10,6 15,0 20,6 25,0 30,6 35,0 40,6" />
</svg>

<style>
	.zigzag {
		display: block;
		width: 100%;
		height: 10px;
		color: var(--charcoal);
	}

	.zigzag polyline {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		vector-effect: non-scaling-stroke;
	}
</style>
