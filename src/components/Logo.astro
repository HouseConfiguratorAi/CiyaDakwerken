---
// Client logo (raster, bevelled) via astro:assets. See BRIEF §2 — the only place bevel/gloss is allowed.
import { Image } from 'astro:assets';
import logoDark from '../assets/brand/ciya-logo.png';
import logoLight from '../assets/brand/ciya-logo-white.png';

interface Props {
	variant?: 'dark' | 'light';
	class?: string;
	loading?: 'eager' | 'lazy';
	height?: number;
}

const { variant = 'dark', class: className, loading = 'eager', height = 48 } = Astro.props;
const src = variant === 'light' ? logoLight : logoDark;
// Source is 1598x634 (ratio ~2.52:1) — derive width from the requested height to avoid CLS.
const ratio = 1598 / 634;
const width = Math.round(height * ratio);
---

<a href="/" class={`logo ${className ?? ''}`} aria-label="Ciya Dakwerken — naar homepage" style={height !== 48 ? `--logo-height:${height}px` : undefined}>
	<Image
		src={src}
		alt="Ciya Dakwerken"
		widths={[160, 240, 320, 480]}
		sizes={`${width}px`}
		width={width}
		height={height}
		loading={loading}
		fetchpriority={loading === 'eager' ? 'high' : 'auto'}
		formats={['webp']}
		class="logo__img"
	/>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		flex: none;
	}

	.logo__img {
		display: block;
		height: var(--logo-height, 40px);
		width: auto;
	}

	@media (min-width: 1024px) {
		.logo__img {
			height: var(--logo-height, 48px);
		}
	}
</style>
