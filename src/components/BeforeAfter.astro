---
// Before/after slider: two stacked <Image>s in a fixed 4:5 frame. "Voor" is the base layer (left),
// "Na" is clipped from the left so it appears on the right. A native range input is the control
// (keyboard accessible); dragging directly on the frame also works. No library.
import { Image } from 'astro:assets';

interface Props {
	before: ImageMetadata;
	beforeAlt: string;
	after: ImageMetadata;
	afterAlt: string;
	label?: string;
	id: string;
}

const { before, after, beforeAlt, afterAlt, label, id } = Astro.props;
---

<div class="ba-slider" data-ba-slider style="--split: 50%">
	<div class="ba-slider__frame" data-ba-frame>
		<Image
			src={before}
			alt={beforeAlt}
			widths={[320, 480, 640, 960]}
			sizes="(min-width: 1024px) 520px, 92vw"
			loading="lazy"
			formats={['avif', 'webp']}
			class="ba-slider__img"
		/>
		<div class="ba-slider__after" data-ba-after>
			<Image
				src={after}
				alt={afterAlt}
				widths={[320, 480, 640, 960]}
				sizes="(min-width: 1024px) 520px, 92vw"
				loading="lazy"
				formats={['avif', 'webp']}
				class="ba-slider__img"
			/>
		</div>
		<div class="ba-slider__divider" aria-hidden="true">
			<span class="ba-slider__handle">
				<svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 6 5 12l4 6M15 6l4 6-4 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" /></svg>
			</span>
		</div>
		<span class="ba-slider__tag ba-slider__tag--voor" aria-hidden="true">Voor</span>
		<span class="ba-slider__tag ba-slider__tag--na" aria-hidden="true">Na</span>
		{label && <span class="ba-slider__label">{label}</span>}
	</div>
	<input
		type="range"
		min="0"
		max="100"
		value="50"
		class="ba-slider__range"
		id={`ba-${id}`}
		aria-label={`Vergelijk voor en na: ${label ?? afterAlt}`}
		data-ba-range
	/>
</div>

<style>
	.ba-slider {
		width: 100%;
	}

	.ba-slider__frame {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--grey-100);
		cursor: ew-resize;
		touch-action: pan-y;
		user-select: none;
	}

	.ba-slider__frame :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.ba-slider__after {
		position: absolute;
		inset: 0;
		clip-path: inset(0 0 0 var(--split));
	}

	.ba-slider__divider {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--split);
		width: 2px;
		margin-left: -1px;
		background: var(--white);
		z-index: 2;
		pointer-events: none;
	}

	.ba-slider__handle {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 40px;
		height: 40px;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		background: var(--white);
		color: var(--black);
		border-radius: var(--radius);
	}

	.ba-slider__tag {
		position: absolute;
		top: 12px;
		background: var(--black);
		color: var(--white);
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 12px;
		letter-spacing: 0.06em;
		padding: 5px 10px;
		border-radius: var(--radius);
		z-index: 3;
		pointer-events: none;
	}

	.ba-slider__tag--voor {
		left: 12px;
	}

	.ba-slider__tag--na {
		right: 12px;
		background: var(--red-600);
	}

	.ba-slider__label {
		position: absolute;
		bottom: 12px;
		left: 12px;
		background: var(--red-600);
		color: var(--white);
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 12px;
		letter-spacing: 0.06em;
		padding: 6px 12px;
		border-radius: var(--radius);
		z-index: 3;
		pointer-events: none;
	}

	.ba-slider__range {
		width: 100%;
		margin-top: 0.85rem;
		accent-color: var(--red-600);
		height: 44px;
		cursor: ew-resize;
	}
</style>

<script>
	function initBaSliders() {
		document.querySelectorAll<HTMLElement>('[data-ba-slider]').forEach((slider) => {
			if (slider.dataset.baReady) return;
			slider.dataset.baReady = '1';
			const range = slider.querySelector<HTMLInputElement>('[data-ba-range]');
			const frame = slider.querySelector<HTMLElement>('[data-ba-frame]');
			if (!range || !frame) return;
			const set = (v: number) => {
				const clamped = Math.max(0, Math.min(100, v));
				slider.style.setProperty('--split', `${clamped}%`);
				if (Number(range.value) !== Math.round(clamped)) range.value = String(Math.round(clamped));
			};
			range.addEventListener('input', () => set(Number(range.value)));
			// Direct drag on the photo
			let dragging = false;
			const fromEvent = (e: PointerEvent) => {
				const r = frame.getBoundingClientRect();
				set(((e.clientX - r.left) / r.width) * 100);
			};
			frame.addEventListener('pointerdown', (e) => {
				dragging = true;
				frame.setPointerCapture(e.pointerId);
				fromEvent(e);
			});
			frame.addEventListener('pointermove', (e) => {
				if (dragging) fromEvent(e);
			});
			const stop = () => {
				dragging = false;
			};
			frame.addEventListener('pointerup', stop);
			frame.addEventListener('pointercancel', stop);
			set(Number(range.value));

			// One gentle sweep when the slider first scrolls into view — signals "drag me".
			let touched = false;
			const markTouched = () => (touched = true);
			frame.addEventListener('pointerdown', markTouched, { once: true });
			range.addEventListener('input', markTouched, { once: true });
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduced && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						if (!entries.some((e) => e.isIntersecting)) return;
						io.disconnect();
						if (touched) return;
						const start = performance.now();
						const dur = 1800;
						const ease = (t: number) => 0.5 - Math.cos(Math.PI * t) / 2;
						const tick = (now: number) => {
							if (touched) return;
							const t = Math.min(1, (now - start) / dur);
							// 50 → 34 → 66 → 50
							const phase = t < 0.33 ? 50 - 16 * ease(t / 0.33) : t < 0.66 ? 34 + 32 * ease((t - 0.33) / 0.33) : 66 - 16 * ease((t - 0.66) / 0.34);
							set(phase);
							if (t < 1) requestAnimationFrame(tick);
							else set(50);
						};
						setTimeout(() => requestAnimationFrame(tick), 400);
					},
					{ threshold: 0.6 },
				);
				io.observe(frame);
			}
		});
	}

	document.addEventListener('astro:page-load', initBaSliders);
</script>
