---
interface Props {
	href?: string;
	variant?: 'primary' | 'dark' | 'ghost';
	icon?: 'phone' | 'arrow' | 'mail' | 'chat';
	iconPosition?: 'left' | 'right';
	type?: 'button' | 'submit';
	class?: string;
	/** Pointer-attracted button (fine pointers only). */
	magnetic?: boolean;
}

import Icon from './Icon.astro';

const {
	href,
	variant = 'primary',
	icon,
	iconPosition = 'left',
	type = 'button',
	class: className,
	magnetic = false,
} = Astro.props;

const classes = `btn btn--${variant}${icon ? ` btn--icon-${iconPosition}` : ''} ${className ?? ''}`;
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={href ? undefined : type} data-magnetic={magnetic ? '' : undefined}>
	{icon && iconPosition === 'left' && <Icon name={icon} />}
	<slot />
	{icon && iconPosition === 'right' && <Icon name={icon} />}
</Tag>
