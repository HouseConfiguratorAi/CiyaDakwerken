---
// One project, three phases (Voor → Isolatie → Na). Same roof in every photo — see data/projects.ts.
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import { projectStory } from '../data/projects';

interface Props {
	/** Show the eyebrow/title block above the steps (default true). */
	heading?: boolean;
	cta?: boolean;
}
const { heading = true, cta = true } = Astro.props;
---

<div class="story">
	{
		heading && (
			<div class="story__head">
				<SectionHeading eyebrow="Eén project, drie fases" title={projectStory.title} />
				<p class="story__intro">{projectStory.intro}</p>
			</div>
		)
	}
	<ol class="story__steps reveal-group snap-row" data-lightbox-group>
		{
			projectStory.steps.map((step, i) => (
				<li class="story__step reveal" style={`--stagger:${i}`}>
					<button type="button" class="story__media" data-lb-item data-lb-caption={`${step.label} — ${step.text}`} data-lb-href={`/diensten/${projectStory.service}/`} aria-label={`Foto vergroten: ${step.label}`}>
						<Image
							src={step.image}
							alt={step.alt}
							widths={[360, 540, 720, 1080]}
							sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
							loading="lazy"
							formats={['avif', 'webp']}
						/>
						<span class="story__label">
							<span class="story__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							{step.label}
						</span>
					</button>
					<p class="story__text">{step.text}</p>
				</li>
			))
		}
	</ol>
	<p class="snap-hint" aria-hidden="true">Veeg om de fases te bekijken</p>
	{
		cta && (
			<div class="story__cta">
				<Button href={`/diensten/${projectStory.service}/`} variant="ghost" icon="arrow" iconPosition="right">
					Meer over platte daken
				</Button>
			</div>
		)
	}
</div>

<style>
	.story__intro {
		margin-top: -0.5rem;
		margin-bottom: 2.5rem;
		max-width: 44rem;
		color: var(--grey-500);
		font-size: 1.05rem;
	}

	.story__steps {
		display: grid;
		gap: 2rem;
	}

	@media (min-width: 640px) {
		.story__steps {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}

	@media (min-width: 1024px) {
		.story__steps {
			gap: 2rem;
		}
	}

	.story__step {
		position: relative;
	}

	/* connector arrows between steps on wide screens */
	@media (min-width: 640px) {
		.story__step + .story__step::before {
			content: '';
			position: absolute;
			left: calc(-0.75rem - 1px);
			top: 0;
			bottom: 0;
			width: 2px;
			background: var(--grey-200);
		}
	}

	@media (min-width: 1024px) {
		.story__step + .story__step::before {
			left: calc(-1rem - 1px);
		}
	}

	.story__media {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--grey-100);
		padding: 0;
		cursor: zoom-in;
		text-align: left;
	}

	.story__media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms var(--ease);
	}

	.story__step:hover .story__media :global(img) {
		transform: scale(1.03);
	}

	.story__label {
		position: absolute;
		left: 12px;
		bottom: 12px;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: var(--black);
		color: var(--white);
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 13px;
		padding: 6px 12px 6px 8px;
		border-radius: var(--radius);
	}

	.story__step:last-child .story__label {
		background: var(--red-600);
	}

	.story__num {
		font-weight: 800;
		font-size: 1.1rem;
		color: var(--red-500);
	}

	.story__step:last-child .story__num {
		color: var(--white);
		opacity: 0.8;
	}

	.story__text {
		margin-top: 1rem;
		color: var(--grey-700);
		font-size: 0.98rem;
	}

	.story__cta {
		margin-top: 2.5rem;
	}
</style>
