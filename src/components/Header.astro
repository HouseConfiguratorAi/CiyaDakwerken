---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const navLinks = [
	{ href: '/projecten/', label: 'Realisaties' },
	{ href: '/kennisbank/', label: 'Kennisbank' },
	{ href: '/over-ons/', label: 'Over ons' },
	{ href: '/contact/', label: 'Contact' },
];

interface Props {
	/** Transparent over a dark hero until scrolled (home). */
	overlay?: boolean;
}
const { overlay = false } = Astro.props;
const currentPath = Astro.url.pathname;
const isDienstenActive = currentPath.startsWith('/diensten/') || currentPath === '/diensten';
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
	<div class="container site-header__inner">
		<Logo variant="dark" loading="eager" class="site-header__logo site-header__logo--dark" />
		{overlay && <Logo variant="light" loading="eager" class="site-header__logo site-header__logo--light" />}

		<nav class="nav-desktop" aria-label="Hoofdnavigatie">
			<ul>
				<li class="nav-desktop__dropdown">
					<button
						type="button"
						class="nav-desktop__trigger"
						aria-expanded="false"
						aria-controls="diensten-dropdown"
						aria-current={isDienstenActive ? 'page' : undefined}
						data-dropdown-trigger
					>
						Diensten
						<Icon name="chevron-down" class="nav-desktop__caret" />
					</button>
					<div class="nav-desktop__panel" id="diensten-dropdown">
						<ul>
							{
								services.map((service, i) => (
									<li style={`--i:${i}`}>
										<a
											href={`/diensten/${service.slug}/`}
											aria-current={currentPath === `/diensten/${service.slug}/` ? 'page' : undefined}
											class="mega__item"
										>
											<span class="mega__tile"><Icon name={service.icon as any} class="mega__icon" /></span>
											<span class="mega__text">
												<strong>{service.name}</strong>
												<small>{service.short}</small>
											</span>
										</a>
									</li>
								))
							}
						</ul>
						<div class="mega__aside">
							<a href="/dakcheck/" class="mega__card">
								<span class="mega__card-eyebrow">Niet zeker?</span>
								<strong>Doe de dakcheck</strong>
								<span class="mega__card-text">Drie vragen, meteen een eerlijke inschatting.</span>
								<span class="mega__card-link">Start <Icon name="arrow" /></span>
							</a>
							<a href={`tel:${site.phoneE164}`} class="mega__phone"><Icon name="phone" />{site.phoneDisplay}</a>
							<a href="/diensten/" class="nav-desktop__all">Alle diensten <Icon name="arrow" /></a>
						</div>
					</div>
				</li>
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="site-header__actions">
			<a href={`tel:${site.phoneE164}`} class="site-header__phone">
				<Icon name="phone" />
				{site.phoneDisplay}
			</a>
			<Button href="/offerte/" variant="primary" class="site-header__cta">Offerte aanvragen</Button>
			<button
				type="button"
				class="nav-toggle"
				aria-expanded="false"
				aria-controls="mobile-drawer"
				data-drawer-trigger
			>
				<Icon name="menu" class="nav-toggle__open" />
				<Icon name="close" class="nav-toggle__close" />
				<span class="visually-hidden">Menu</span>
			</button>
		</div>
	</div>
</header>

<div class="drawer" id="mobile-drawer" data-drawer hidden>
	<div class="drawer__header">
		<Logo variant="dark" loading="eager" height={36} />
		<button type="button" class="nav-toggle nav-toggle--close" data-drawer-close>
			<Icon name="close" />
			<span class="visually-hidden">Sluit menu</span>
		</button>
	</div>
	<nav class="drawer__nav" aria-label="Mobiele navigatie">
		<ul>
			<li style="--e:0">
				<button
					type="button"
					class="drawer__services-trigger"
					aria-expanded="false"
					aria-controls="drawer-services"
					aria-current={isDienstenActive ? 'page' : undefined}
					data-drawer-services-trigger
				>
					Diensten
					<Icon name="chevron-down" />
				</button>
				<ul class="drawer__services" id="drawer-services" hidden>
					{
						services.map((service) => (
							<li>
								<a
									href={`/diensten/${service.slug}/`}
									aria-current={currentPath === `/diensten/${service.slug}/` ? 'page' : undefined}
								>
									{service.name}
								</a>
							</li>
						))
					}
					<li><a href="/diensten/">Alle diensten</a></li>
				</ul>
			</li>
			{
				[...navLinks, { href: '/dakcheck/', label: 'Dakcheck' }].map((link, i) => (
					<li style={`--e:${i + 1}`}>
						<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="drawer__actions">
		<Button href={`tel:${site.phoneE164}`} variant="ghost" icon="phone">Bel {site.phoneDisplay}</Button>
		<Button href="/offerte/" variant="primary">Offerte aanvragen</Button>
	</div>
</div>
<div class="drawer__backdrop" data-drawer-backdrop hidden></div>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--white);
		border-bottom: var(--border-light);
		transition: padding var(--dur-base) var(--ease), background var(--dur-base) var(--ease),
			box-shadow var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease);
	}

	/* Scrolled: translucent glass so content passes underneath (no hard divider) */
	.site-header.is-scrolled {
		background: rgba(255, 255, 255, 0.93);
		-webkit-backdrop-filter: blur(16px) saturate(1.6);
		backdrop-filter: blur(16px) saturate(1.6);
		border-bottom-color: rgba(10, 10, 10, 0.06);
		box-shadow: 0 10px 30px -18px rgba(10, 10, 10, 0.35);
	}

	@media (prefers-reduced-transparency: reduce) {
		.site-header.is-scrolled {
			background: var(--white);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 14px;
		transition: padding var(--dur-base) var(--ease);
	}

	.site-header.is-scrolled .site-header__inner {
		padding-block: 8px;
	}

	/* Overlay variant (home): transparent over the dark hero until scrolled */
	.site-header--overlay:not(.is-scrolled) {
		background: transparent;
		border-bottom-color: transparent;
		color: var(--white);
	}

	.site-header--overlay {
		transition: background var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease), color var(--dur-base) var(--ease);
	}

	.site-header :global(.site-header__logo--light) {
		display: none;
	}

	.site-header--overlay:not(.is-scrolled) :global(.site-header__logo--light) {
		display: inline-flex;
	}

	.site-header--overlay:not(.is-scrolled) :global(.site-header__logo--dark) {
		display: none;
	}

	.site-header--overlay:not(.is-scrolled) .nav-desktop > ul > li > a:hover,
	.site-header--overlay:not(.is-scrolled) .nav-desktop__trigger:hover {
		color: var(--red-400);
	}

	.site-header--overlay:not(.is-scrolled) .nav-desktop__panel {
		color: var(--ink);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__phone :global(.icon) {
		color: var(--red-500);
	}

	.nav-desktop {
		display: none;
	}

	@media (min-width: 1024px) {
		.nav-desktop {
			display: block;
		}
	}

	.nav-desktop > ul {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	/* Top-level links only: the panel's own links are styled separately (an unscoped `.nav-desktop a`
	   used to override the mega card's grid layout). */
	.nav-desktop > ul > li > a,
	.nav-desktop__trigger {
		position: relative;
		font-weight: 500;
		font-size: 0.95rem;
		padding: 0.5rem 0;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: color var(--dur-base) var(--ease);
	}

	.nav-desktop > ul > li > a::after,
	.nav-desktop__trigger::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: var(--red-600);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.nav-desktop > ul > li > a:hover,
	.nav-desktop__trigger:hover {
		color: var(--red-600);
	}

	.nav-desktop > ul > li > a:hover::after,
	.nav-desktop > ul > li > a:focus-visible::after,
	.nav-desktop > ul > li > a[aria-current='page']::after,
	.nav-desktop__trigger:hover::after,
	.nav-desktop__trigger[aria-current='page']::after,
	.nav-desktop__dropdown.is-open .nav-desktop__trigger::after {
		transform: scaleX(1);
	}

	.site-header--overlay:not(.is-scrolled) .nav-desktop > ul > li > a::after,
	.site-header--overlay:not(.is-scrolled) .nav-desktop__trigger::after {
		background: var(--red-500);
	}

	.nav-desktop__dropdown {
		position: static;
	}

	.site-header__inner {
		position: relative;
	}

	:global(.nav-desktop__caret) {
		width: 14px;
		height: 14px;
		transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.nav-desktop__dropdown:focus-within :global(.nav-desktop__caret),
	.nav-desktop__dropdown.is-open :global(.nav-desktop__caret) {
		transform: rotate(180deg);
	}

	/* Mega panel: spans the header container, so it can never overflow narrow desktops */
	.nav-desktop__panel {
		position: absolute;
		top: calc(100% - 2px);
		left: var(--gutter);
		right: var(--gutter);
		padding: 1.5rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 270px;
		gap: 1.75rem;
		background: rgba(255, 255, 255, 0.97);
		-webkit-backdrop-filter: blur(18px) saturate(1.4);
		backdrop-filter: blur(18px) saturate(1.4);
		border: 1px solid rgba(10, 10, 10, 0.06);
		border-top: 3px solid var(--red-600);
		border-radius: 0 0 8px 8px;
		box-shadow: 0 34px 60px -24px rgba(10, 10, 10, 0.35);
		color: var(--ink);
		z-index: 10;
		clip-path: inset(0 -60px 100% -60px);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: clip-path 420ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms var(--ease),
			transform 420ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 420ms;
	}

	/* invisible bridge so the pointer can travel from the trigger into the panel */
	.nav-desktop__panel::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: -26px;
		height: 26px;
	}

	.nav-desktop__dropdown:focus-within .nav-desktop__panel,
	.nav-desktop__dropdown.is-open .nav-desktop__panel {
		clip-path: inset(0 -60px -80px -60px);
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition-delay: 0s;
	}

	.nav-desktop__panel > ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.2rem 0.5rem;
		align-content: start;
	}

	@media (min-width: 1200px) {
		.nav-desktop__panel > ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.nav-desktop__panel {
			grid-template-columns: minmax(0, 1fr) 290px;
		}
	}

	.nav-desktop__panel .mega__item {
		display: flex;
		gap: 0.85rem;
		align-items: flex-start;
		padding: 0.7rem 0.75rem;
		border-radius: 6px;
		transition: background var(--dur-base) var(--ease);
	}

	.nav-desktop__panel .mega__item:hover,
	.nav-desktop__panel .mega__item:focus-visible {
		background: var(--grey-100);
		color: var(--ink);
	}

	.nav-desktop__panel .mega__item[aria-current='page'] {
		background: var(--grey-100);
	}

	.mega__tile {
		display: grid;
		place-items: center;
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: 8px;
		background: rgba(197, 31, 42, 0.08);
		color: var(--red-600);
		transition: background var(--dur-base) var(--ease), color var(--dur-base) var(--ease),
			transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.nav-desktop__panel .mega__item:hover .mega__tile,
	.nav-desktop__panel .mega__item:focus-visible .mega__tile {
		background: var(--red-600);
		color: var(--white);
		transform: rotate(-6deg) scale(1.08);
	}

	.nav-desktop__panel :global(.mega__icon) {
		width: 20px;
		height: 20px;
	}

	/* Items glide in one after the other when the panel opens */
	.nav-desktop__dropdown:focus-within .mega__item,
	.nav-desktop__dropdown.is-open .mega__item {
		animation: mega-in 460ms cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: calc(70ms + var(--i, 0) * 28ms);
	}

	@keyframes mega-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.mega__text {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
		padding-top: 1px;
	}

	.mega__text strong {
		font-weight: 600;
		font-size: 0.95rem;
		line-height: 1.2;
	}

	.mega__text small {
		font-size: 0.8rem;
		color: var(--grey-500);
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.mega__aside {
		display: grid;
		gap: 0.9rem;
		align-content: start;
		border-left: var(--border-light);
		padding-left: 1.75rem;
	}

	.nav-desktop__panel .mega__card {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		display: grid;
		gap: 0.4rem;
		padding: 1.25rem 1.25rem 1.1rem;
		background: radial-gradient(120% 100% at 100% 0%, rgba(217, 50, 60, 0.42), transparent 60%), var(--charcoal);
		color: var(--white);
		border-radius: 6px;
		border-top: 3px solid var(--red-600);
		transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 380ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.nav-desktop__panel .mega__card:hover,
	.nav-desktop__panel .mega__card:focus-visible {
		color: var(--white);
		transform: translateY(-3px);
		box-shadow: 0 18px 30px -14px rgba(10, 10, 10, 0.55);
	}

	.mega__card-eyebrow {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.72rem;
		color: var(--red-400);
	}

	.mega__card strong {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 1.35rem;
		line-height: 1;
	}

	.mega__card-text {
		font-size: 0.86rem;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.78);
	}

	.mega__card-link {
		margin-top: 0.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 700;
		font-size: 0.85rem;
	}

	.mega__card-link :global(.icon),
	.nav-desktop__all :global(.icon) {
		width: 16px;
		height: 16px;
		transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mega__card:hover .mega__card-link :global(.icon),
	.nav-desktop__all:hover :global(.icon) {
		transform: translateX(5px);
	}

	.nav-desktop__panel .mega__phone {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 600;
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
	}

	.nav-desktop__panel .mega__phone :global(.icon) {
		width: 18px;
		height: 18px;
		color: var(--red-600);
	}

	.nav-desktop__panel .nav-desktop__all {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 700;
		font-size: 0.88rem;
		color: var(--red-600);
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.site-header__phone {
		display: none;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.site-header__phone :global(.icon) {
		width: 18px;
		height: 18px;
		color: var(--red-600);
	}

	@media (min-width: 1024px) {
		.site-header__phone {
			display: inline-flex;
		}
	}

	.site-header__cta {
		display: none;
	}

	@media (min-width: 1024px) {
		.site-header__cta {
			display: inline-flex;
		}
	}

	.nav-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: var(--radius);
	}

	.nav-toggle :global(.nav-toggle__close) {
		display: none;
	}

	.nav-toggle[aria-expanded='true'] :global(.nav-toggle__open) {
		display: none;
	}

	.nav-toggle[aria-expanded='true'] :global(.nav-toggle__close) {
		display: block;
	}

	@media (min-width: 1024px) {
		.nav-toggle {
			display: none;
		}
	}

	/* Mobile drawer */
	.drawer {
		position: fixed;
		inset: 0;
		z-index: 200;
		background: var(--white);
		display: flex;
		flex-direction: column;
		padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
			env(safe-area-inset-left);
		overflow-y: auto;
	}

	.drawer[hidden] {
		display: none;
	}

	@media (min-width: 1024px) {
		.drawer,
		.drawer__backdrop {
			display: none !important;
		}
	}

	.drawer__backdrop {
		position: fixed;
		inset: 0;
		z-index: 190;
		background: rgba(10, 10, 10, 0.5);
	}

	.drawer__backdrop[hidden] {
		display: none;
	}

	.drawer__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem var(--gutter);
		border-bottom: var(--border-light);
	}

	.drawer__nav {
		padding: 1rem var(--gutter);
		flex-grow: 1;
	}

	.drawer__nav > ul > li + li {
		border-top: var(--border-light);
	}

	.drawer__nav > ul > li > a {
		display: block;
		padding: 1rem 0.25rem;
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 1.1rem;
	}

	.drawer__services-trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 1rem 0.25rem;
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: 1.1rem;
	}

	.drawer__services-trigger :global(.icon) {
		transition: transform var(--dur-base) var(--ease);
	}

	.drawer__services-trigger[aria-expanded='true'] :global(.icon) {
		transform: rotate(180deg);
	}

	.drawer__services {
		padding-bottom: 0.75rem;
	}

	.drawer__services[hidden] {
		display: none;
	}

	.drawer__nav a[aria-current='page'],
	.drawer__services-trigger[aria-current='page'],
	.drawer__services a[aria-current='page'] {
		color: var(--red-600);
	}

	.drawer__services a {
		display: block;
		padding: 0.6rem 0.25rem 0.6rem 1rem;
		font-size: 0.95rem;
		color: var(--grey-500);
	}

	.drawer__actions {
		display: grid;
		gap: 0.75rem;
		padding: 1rem var(--gutter) 1.5rem;
		border-top: var(--border-light);
	}

	.drawer__actions :global(.btn) {
		width: 100%;
	}
</style>

<script>
	function initHeader() {
		const header = document.querySelector<HTMLElement>('[data-header]');
		if (header) {
			const w = window as any;
			if (w.__headerScroll) window.removeEventListener('scroll', w.__headerScroll);
			w.__headerScroll = () => {
				header.classList.toggle('is-scrolled', window.scrollY > 8);
			};
			w.__headerScroll();
			window.addEventListener('scroll', w.__headerScroll, { passive: true });
		}

		// Desktop dropdown: click/touch support in addition to focus-within/hover.
		const dropdownTrigger = document.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
		const dropdown = dropdownTrigger?.closest('.nav-desktop__dropdown');
		if (dropdownTrigger && dropdown) {
			const setOpen = (open: boolean) => {
				dropdown.classList.toggle('is-open', open);
				dropdownTrigger.setAttribute('aria-expanded', String(open));
			};
			dropdownTrigger.addEventListener('click', () => setOpen(!dropdown.classList.contains('is-open')));
			// Hover intent (mouse only): open after 120ms, close after leaving for 200ms.
			let openTimer: number | undefined;
			let closeTimer: number | undefined;
			if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
				dropdown.addEventListener('mouseenter', () => {
					window.clearTimeout(closeTimer);
					openTimer = window.setTimeout(() => setOpen(true), 120);
				});
				dropdown.addEventListener('mouseleave', () => {
					window.clearTimeout(openTimer);
					closeTimer = window.setTimeout(() => setOpen(false), 200);
				});
			}
			document.addEventListener('click', (e) => {
				if (!dropdown.isConnected) return;
				if (!dropdown.contains(e.target as Node)) setOpen(false);
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && dropdown.isConnected) setOpen(false);
			});
		}

		// Mobile drawer
		const drawerTrigger = document.querySelector<HTMLButtonElement>('[data-drawer-trigger]');
		const drawerCloseBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');
		const drawer = document.querySelector<HTMLElement>('[data-drawer]');
		const backdrop = document.querySelector<HTMLElement>('[data-drawer-backdrop]');

		const openDrawer = () => {
			drawer?.removeAttribute('hidden');
			backdrop?.removeAttribute('hidden');
			drawerTrigger?.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
		};
		const closeDrawer = () => {
			drawer?.setAttribute('hidden', '');
			backdrop?.setAttribute('hidden', '');
			drawerTrigger?.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
		};

		drawerTrigger?.addEventListener('click', () => {
			const isOpen = drawerTrigger.getAttribute('aria-expanded') === 'true';
			isOpen ? closeDrawer() : openDrawer();
		});
		drawerCloseBtn?.addEventListener('click', closeDrawer);
		backdrop?.addEventListener('click', closeDrawer);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && drawer?.isConnected) closeDrawer();
		});

		// Drawer services expandable list
		const servicesTrigger = document.querySelector<HTMLButtonElement>('[data-drawer-services-trigger]');
		const servicesList = document.querySelector<HTMLElement>('#drawer-services');
		servicesTrigger?.addEventListener('click', () => {
			const isOpen = servicesTrigger.getAttribute('aria-expanded') === 'true';
			servicesTrigger.setAttribute('aria-expanded', String(!isOpen));
			if (isOpen) {
				servicesList?.setAttribute('hidden', '');
			} else {
				servicesList?.removeAttribute('hidden');
			}
		});
	}

	document.addEventListener('astro:page-load', initHeader);
	// Reset body scroll lock if a navigation happens while the drawer is open.
	document.addEventListener('astro:before-swap', () => {
		document.body.style.overflow = '';
	});
</script>
