---
// Roofing vs EPDM vs vloeibare dakbedekking — general, hedged comparison. No prices, no brand claims.
import SectionHeading from './SectionHeading.astro';

const cols = [
	{ slug: 'roofing', name: 'Roofing (bitumen)' },
	{ slug: 'epdm', name: 'EPDM (rubber)' },
	{ slug: 'vloeibare-dakbedekking', name: 'Vloeibare dakbedekking' },
];

const rows: { label: string; cells: string[] }[] = [
	{ label: 'Best geschikt voor', cells: ['Rechthoekige platte daken, nieuwbouw en vernieuwing', 'Daken met veel hoeken, doorvoeren of opstanden', 'Kleine oppervlakken en moeilijke details'] },
	{ label: 'Plaatsing', cells: ['In banen, dichtgebrand of gekleefd, meerdere lagen', 'Grote banen, verlijmd of mechanisch bevestigd — weinig naden', 'Vloeibaar aangebracht, hardt uit tot één naadloze laag'] },
	{ label: 'Naden', cells: ['Overlappen per baan, zorgvuldig dichtgebrand', 'Zeer weinig naden dankzij grote baanbreedtes', 'Geen naden'] },
	{ label: 'Levensduur', cells: ['Doorgaans lang bij correcte plaatsing en onderhoud', 'Doorgaans zeer lang; flexibel en UV-bestendig', 'Afhankelijk van ondergrond en belasting'] },
	{ label: 'Herstelbaar', cells: ['Ja, lokaal', 'Ja, lokaal', 'Ja, vaak de herstelling zelf'] },
	{ label: 'Ons advies', cells: ['Beproefd en stevig — een vertrouwde keuze', 'Onze voorkeur bij complexe daken', 'Als aanvulling op roofing of EPDM'] },
];
---

<div class="compare">
	<SectionHeading level="h2" eyebrow="Roofing, EPDM of vloeibaar?" title="Welke afdichting past bij uw plat dak" />
	<p class="compare__intro">
		Elk materiaal heeft zijn plek. Dit is hoe we ze in de praktijk inzetten — wat op uw dak het beste past, bekijken we ter plaatse.
	</p>
	<div class="compare__scroll">
		<table class="compare__table">
			<thead>
				<tr>
					<th scope="col"><span class="visually-hidden">Kenmerk</span></th>
					{cols.map((c) => <th scope="col"><a href={`/diensten/${c.slug}/`}>{c.name}</a></th>)}
				</tr>
			</thead>
			<tbody>
				{
					rows.map((r) => (
						<tr>
							<th scope="row">{r.label}</th>
							{r.cells.map((cell) => <td>{cell}</td>)}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<p class="compare__hint snap-hint" aria-hidden="true">Veeg om de tabel te bekijken</p>
</div>

<style>
	.compare__intro {
		margin-top: -0.5rem;
		margin-bottom: 2rem;
		max-width: 44rem;
		color: var(--grey-500);
		font-size: 1.05rem;
	}

	.compare__scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		margin-inline: calc(var(--gutter) * -1);
		padding-inline: var(--gutter);
	}

	.compare__table {
		width: 100%;
		min-width: 760px;
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	.compare__table th,
	.compare__table td {
		padding: 1rem 1rem;
		text-align: left;
		vertical-align: top;
		border-bottom: var(--border-light);
	}

	.compare__table thead th {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 1.05rem;
		border-bottom: 3px solid var(--red-600);
		background: var(--grey-100);
	}

	.compare__table thead th a:hover {
		color: var(--red-700);
	}

	.compare__table tbody th {
		font-weight: 600;
		color: var(--ink);
		width: 18%;
		background: var(--grey-100);
	}

	.compare__table td {
		color: var(--grey-700);
	}

	.compare__table tbody tr:last-child td {
		font-weight: 600;
		color: var(--red-700);
	}

	@media (min-width: 640px) {
		.compare__hint {
			display: none;
		}
	}
</style>
