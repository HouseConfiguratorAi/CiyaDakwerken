---
// Captioned photo grid of real work. Captions are factual (what is visible), each links to its service.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { GalleryItem } from '../data/projects';
import { getService } from '../data/services';

interface Props {
	items: GalleryItem[];
	/** Max items to show (default all). */
	limit?: number;
}
const { items, limit } = Astro.props;
const shown = limit ? items.slice(0, limit) : items;
---

<ul class="gallery reveal-group snap-row" data-lightbox-group>
	{
		shown.map((item, i) => {
			const service = getService(item.service);
			return (
				<li class="gallery__item reveal-motion" style={`--stagger:${i % 6}`}>
					<div class="gallery__link">
						<button
							type="button"
							class="gallery__media"
							data-lb-item
							data-lb-caption={item.caption}
							data-lb-href={service ? `/diensten/${service.slug}/` : ''}
							aria-label={`Foto vergroten: ${item.caption}`}
						>
							<Image
								src={item.image}
								alt={item.alt}
								widths={[320, 480, 640, 960]}
								sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
								loading="lazy"
								formats={['avif', 'webp']}
							/>
							<span class="gallery__zoom" aria-hidden="true">
								<svg viewBox="0 0 24 24"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" /></svg>
							</span>
						</button>
						<a class="gallery__caption" href={service ? `/diensten/${service.slug}/` : '/diensten/'}>
							<span class="gallery__text">
								<strong>{item.caption}</strong>
								{service && <small>{service.name}</small>}
							</span>
							<Icon name="arrow" class="gallery__arrow" />
						</a>
					</div>
				</li>
			);
		})
	}
</ul>
<p class="snap-hint" aria-hidden="true">Veeg voor meer foto's</p>

<style>
	.gallery {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 640px) {
		.gallery {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.gallery {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.75rem;
		}
	}

	.gallery__link {
		display: block;
	}

	.gallery__media {
		display: block;
		width: 100%;
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--grey-100);
		cursor: zoom-in;
		padding: 0;
		text-align: left;
	}

	.gallery__zoom {
		position: absolute;
		right: 10px;
		top: 10px;
		width: 36px;
		height: 36px;
		display: grid;
		place-items: center;
		background: rgba(10, 10, 10, 0.7);
		color: var(--white);
		border-radius: var(--radius);
		opacity: 0;
		transform: translateY(-4px);
		transition: opacity var(--dur-base) var(--ease), transform var(--dur-base) var(--ease);
	}

	.gallery__zoom svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: square;
	}

	.gallery__media:hover .gallery__zoom,
	.gallery__media:focus-visible .gallery__zoom {
		opacity: 1;
		transform: none;
	}

	@media (hover: none) {
		.gallery__zoom {
			opacity: 1;
			transform: none;
		}
	}

	.gallery__media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms var(--ease);
	}

	.gallery__media:hover :global(img),
	.gallery__media:focus-visible :global(img) {
		transform: scale(1.04);
	}

	.gallery__caption {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 0.25rem 0;
		border-top: 3px solid transparent;
		margin-top: 0.75rem;
		transition: border-color var(--dur-base) var(--ease);
	}

	.gallery__caption:hover,
	.gallery__caption:focus-visible {
		border-top-color: var(--red-600);
	}

	.gallery__text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.gallery__text strong {
		font-weight: 600;
		font-size: 0.98rem;
	}

	.gallery__text small {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--red-700);
		font-family: var(--font-display);
		font-weight: 700;
	}

	.gallery :global(.gallery__arrow) {
		width: 20px;
		height: 20px;
		flex: none;
		color: var(--grey-400);
		transition: transform var(--dur-base) var(--ease), color var(--dur-base) var(--ease);
	}

	.gallery__caption:hover :global(.gallery__arrow) {
		color: var(--red-600);
		transform: translateX(4px);
	}
</style>
