---
// Full-bleed photo band with a short statement. Uses a real project photo (portrait source,
// cropped by object-fit). Keep the text short — this is a breather, not a content section.
import { Image } from 'astro:assets';
import Button from './Button.astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	eyebrow?: string;
	title: string;
	text?: string;
	ctaHref?: string;
	ctaLabel?: string;
	/** Which part of the photo to keep when cropping (CSS object-position). */
	position?: string;
}
const { image, alt, eyebrow, title, text, ctaHref, ctaLabel, position = 'center 40%' } = Astro.props;
---

<section class="band">
	<Image
		src={image}
		alt={alt}
		widths={[640, 960, 1280, 1600]}
		sizes="100vw"
		loading="lazy"
		formats={['avif', 'webp']}
		class="band__img"
		style={`object-position: ${position}`}
	/>
	<div class="band__overlay" aria-hidden="true"></div>
	<div class="container band__inner">
		<div class="band__content reveal">
			{eyebrow && <p class="band__eyebrow">{eyebrow}</p>}
			<h2 class="band__title">{title}</h2>
			{text && <p class="band__text">{text}</p>}
			{
				ctaHref && ctaLabel && (
					<div class="band__cta">
						<Button href={ctaHref} variant="primary">{ctaLabel}</Button>
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.band {
		position: relative;
		min-height: 420px;
		display: flex;
		align-items: center;
		color: var(--white);
		background: var(--charcoal);
		overflow: hidden;
	}

	@media (min-width: 1024px) {
		.band {
			min-height: 520px;
		}
	}

	.band :global(.band__img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.band__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(10, 10, 10, 0.82) 0%, rgba(10, 10, 10, 0.55) 55%, rgba(10, 10, 10, 0.25) 100%);
	}

	@media (max-width: 767px) {
		.band__overlay {
			background: rgba(10, 10, 10, 0.68);
		}
	}

	.band__inner {
		position: relative;
		padding-block: 4rem;
	}

	.band__content {
		max-width: 34rem;
	}

	.band__eyebrow {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8125rem;
		color: var(--red-500);
		margin-bottom: 1rem;
	}

	.band__eyebrow::before {
		content: '';
		display: inline-block;
		width: 22px;
		height: 3px;
		background: var(--red-600);
		margin-right: 0.75rem;
		vertical-align: middle;
	}

	.band__title {
		font-size: clamp(2.25rem, 1.8rem + 2.4vw, 4rem);
	}

	.band__text {
		margin-top: 1.25rem;
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.85);
	}

	.band__cta {
		margin-top: 2rem;
	}
</style>
